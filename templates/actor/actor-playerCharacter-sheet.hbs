<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources grid grid-3col">
 
        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <button id="brains-roll-button">
            <label for="system.brains.value" class="resource-label">Brains</label>
          </button>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.brains.value" value="{{system.brains.value}}" data-dtype="Number"/>
          {{!-- <span> / </span>
          <input type="text" name="system.brains.max" value="{{system.brains.max}}" data-dtype="Number"/> --}}
          </div>
        </div>

        <div class="resource flex-group-center">
          <button id="brawns-roll-button">
            <label for="system.brawns.value" class="resource-label">Brawns</label>
          </button>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.brawns.value" value="{{system.brawns.value}}" data-dtype="Number"/>
          {{!-- <span> / </span>
          <input type="text" name="system.brawns.max" value="{{system.brawns.max}}" data-dtype="Number"/> --}}
          </div>
        </div>

        <div class="resource flex-group-center">
          <button id="bravery-roll-button">
            <label for="system.bravery.value" class="resource-label">Bravery</label>
          </button>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.bravery.value" value="{{system.bravery.value}}" data-dtype="Number"/>
          {{!-- <span> / </span>
          <input type="text" name="system.bravery.max" value="{{system.bravery.max}}" data-dtype="Number"/> --}}
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.plot.value" class="resource-label">Plot</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.plot.value" value="{{system.plot.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.plot.max" value="{{system.plot.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">Health</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.resolve.value" class="resource-label">Resolve</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.resolve.value" value="{{system.resolve.value}}" data-dtype="Number"/>
          <span> / </span>
          <input type="text" name="system.resolve.max" value="{{system.resolve.max}}" data-dtype="Number"/>
          </div>
        </div>

        {{!-- <div class="resource flex-group-center">
          <label for="system.attributes.level.value" class="resource-label">Level</label>
          <div class="resource-content flexrow flex-center flex-between">
          <input type="text" name="system.attributes.level.value" value="{{system.attributes.level.value}}" data-dtype="Number"/>
          </div>
        </div> --}}
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    {{!-- <a class="item" data-tab="features">Features</a> --}}
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="inventory">Inventory</a>
    <a class="item" data-tab="secretActions">Secret Actions</a>
    <a class="item" data-tab="traitsFlawsConditions">Traits, Flaws & Conditions</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <section class="grid grid-3col">
        <aside class="sidebar">

          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns.  --}}
          <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d20+@abilities.{{key}}.mod" data-label="{{localize (lookup @root.config.abilities key)}}">{{localize (lookup @root.config.abilities key)}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
              <span class="ability-mod rollable" data-roll="d20+@abilities.{{key}}.mod" data-label="{{localize (lookup @root.config.abilities key)}}">{{numberFormat ability.mod decimals=0 sign=true}}</span>
            </div>
            {{/each}}
          </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
          {{> "systems/jjba-ttrpg/templates/actor/parts/actor-features.hbs"}}
        </section>

      </section>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      <div class="grid grid-2col">
        <div class="resource-content flexrow flex-between">
          <label for="system.age">Age</label>
          <input type="text" name="system.age" value="{{system.age}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.nationality">Nationality</label>
          <input type="text" name="system.nationality" value="{{system.nationality}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.birthday">Birthday</label>
          <input type="text" name="system.birthday" value="{{system.birthday}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.eyeColor">Eye Color</label>
          <input type="text" name="system.eyeColor" value="{{system.eyeColor}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.zodiacSign">Zodiac Sign</label>
          <input type="text" name="system.zodiacSign" value="{{system.zodiacSign}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.favoriteMovie">Favorite Movie</label>
          <input type="text" name="system.favoriteMovie" value="{{system.favoriteMovie}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.gender">Gender</label>
          <input type="text" name="system.gender" value="{{system.gender}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.favoriteFood">Favorite Food</label>
          <input type="text" name="system.favoriteFood" value="{{system.favoriteFood}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.height">Height</label>
          <input type="text" name="system.height" value="{{system.height}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.favoriteActor">Favorite Actor</label>
          <input type="text" name="system.favoriteActor" value="{{system.favoriteActor}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.weight">Weight</label>
          <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.favoriteMusician">Favorite Musician</label>
          <input type="text" name="system.favoriteMusician" value="{{system.favoriteMusician}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.bloodType">Blood Type</label>
          <input type="text" name="system.bloodType" value="{{system.bloodType}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.favoriteAthlete">Favorite Athlete</label>
          <input type="text" name="system.favoriteAthlete" value="{{system.favoriteAthlete}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <label for="system.occupation">Occupation</label>
          <input type="text" name="system.occupation" value="{{system.occupation}}" data-dtype="String"/>
        </div>

        <div class="resource-content flexrow flex-between">
          <input type="text" name="system.freeInput" value="{{system.freeInput}}" data-dtype="String" placeholder="Free Input"/>
          <input type="text" name="system.freeInputValue" value="{{system.freeInputValue}}" data-dtype="String"/>
        </div>
          
      </div>
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{!-- {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}} --}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab inventory" data-group="primary" data-tab="inventory">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedInventory target="system.inventory" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Secret Action Tab --}}
    <div class="tab secretActions" data-group="primary" data-tab="secretActions">
      <div>Secret</div>
    </div>

    {{!-- Secret Action Tab --}}
    <div class="tab traitsFlawsConditions" data-group="primary" data-tab="traitsFlawsConditions">

    </div>

{{!-- 
    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/jjba-ttrpg/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Spells Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/jjba-ttrpg/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/jjba-ttrpg/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
